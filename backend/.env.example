# Google AI Studio / Gemini (required for Gemini chat and embeddings)
GEMINI_API_KEY=your-existing-gemini-api-key-here
# GOOGLE_API_KEY remains supported as a backward-compatible alias.

# Optional alternate chat provider; embeddings continue to use Gemini.
OPENAI_API_KEY=your-openai-api-key-here
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-4o-mini
# Optional Gemini embedding controls (shared by upload, migration, and retrieval)
# GEMINI_EMBEDDING_BATCH_SIZE=64
# GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
# Per-process embedding quota guard; tune from the project's AI Studio limit.
# GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=60

# CORS origins, comma-separated. Use the exact deployed frontend origin.
FRONTEND_URL=http://localhost:5173,http://localhost:80
LOG_LEVEL=INFO
# PORT is supplied by Render/Cloud Run; local Docker Compose sets 8000.

# Database selection (SQLite remains the local default)
DATABASE_PROVIDER=sqlite
# For SQLite, optionally use a local path or sqlite:/// URL. DB_PATH remains
# supported as a backward-compatible fallback when DATABASE_URL is unset.
# DATABASE_URL=database/chatbot.db
# For hosted Turso, set DATABASE_PROVIDER=turso, DATABASE_URL=libsql://..., and
# DATABASE_AUTH_TOKEN to a database-scoped token. Keep the token backend-only.
# DATABASE_PROVIDER=turso
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-database-token

# Private document file storage. local is for development; use r2 for
# Backblaze B2 or Cloudflare R2 through the same S3-compatible adapter.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# B2 example endpoint: https://s3.<region>.backblazeb2.com
# Cloudflare R2 may omit R2_ENDPOINT and provide R2_ACCOUNT_ID instead.
R2_ENDPOINT=
